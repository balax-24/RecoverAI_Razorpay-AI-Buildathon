datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
  ANALYST
  VIEWER
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum RecoveryStatus {
  PENDING
  EVALUATING
  ACTION_SCHEDULED
  ACTION_EXECUTED
  IN_GRACE_PERIOD
  PENDING_APPROVAL
  RECOVERED
  EXHAUSTED
  BLOCKED
  CANCELLED
}

enum RecoveryActionType {
  SMART_RETRY
  PAYMENT_LINK
  CUSTOMER_MESSAGING
  INCENTIVE_OFFER
  MANUAL_INTERVENTION
}

enum ActionExecutionStatus {
  SCHEDULED
  EXECUTING
  SUCCESS
  FAILED
  SKIPPED
  REJECTED
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ActorType {
  USER
  AI_AGENT
  SYSTEM
  WEBHOOK
  WORKER
  ADMIN
}

enum WebhookProcessingStatus {
  RECEIVED
  VALIDATED
  ENQUEUED
  PROCESSED
  DUPLICATE
  FAILED
  DEAD_LETTER
}

enum ReconciliationStatus {
  MATCHED
  MISMATCH_DETECTED
  RECONCILED_AUTOMATICALLY
  MANUAL_ATTENTION_REQUIRED
}

// -------------------------------------------------------------
// Core Tenancy & Identity
// -------------------------------------------------------------

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(100)
  slug              String             @unique @db.VarChar(100)
  razorpayKeyId     String?            @map("razorpay_key_id") @db.VarChar(100)
  razorpaySecretEnc String?            @map("razorpay_secret_enc") @db.Text
  webhookSecretEnc  String?            @map("webhook_secret_enc") @db.Text
  isLiveMode        Boolean            @default(false) @map("is_live_mode")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  users             User[]
  customers         Customer[]
  orders            Order[]
  payments          Payment[]
  recoveryCases     RecoveryCase[]
  policies          Policy[]
  auditEvents       AuditEvent[]
  featureFlags      TenantFeatureFlag[]
  reconcileLogs     ReconciliationLog[]

  @@map("organizations")
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  email          String         @unique @db.VarChar(255)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  fullName       String         @map("full_name") @db.VarChar(150)
  role           UserRole       @default(VIEWER)
  isActive       Boolean        @default(true) @map("is_active")
  mfaSecretEnc   String?        @map("mfa_secret_enc") @db.Text
  mfaEnabled     Boolean        @default(false) @map("mfa_enabled")
  lastLoginAt    DateTime?      @map("last_login_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       Session[]
  approvalsReviewed Approval[]  @relation("ApproverUser")
  auditActions   AuditEvent[]   @relation("ActorUser")

  @@index([organizationId])
  @@map("users")
}

model Session {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  sessionToken   String         @unique @map("session_token") @db.VarChar(255)
  ipAddress      String?        @map("ip_address") @db.VarChar(45)
  userAgent      String?        @map("user_agent") @db.Text
  expiresAt      DateTime       @map("expires_at")
  isRevoked      Boolean        @default(false) @map("is_revoked")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

// -------------------------------------------------------------
// Customers & Payments Domain
// -------------------------------------------------------------

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  externalRef    String         @map("external_ref") @db.VarChar(100)
  email          String         @db.VarChar(255)
  phone          String?        @db.VarChar(20)
  name           String         @db.VarChar(150)
  ltvAmount      Decimal        @default(0.00) @map("ltv_amount") @db.Decimal(12, 2)
  riskScore      Decimal        @default(0.00) @map("risk_score") @db.Decimal(5, 2)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  payments       Payment[]
  recoveryCases  RecoveryCase[]

  @@unique([organizationId, externalRef])
  @@index([organizationId, email])
  @@map("customers")
}

model Order {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  razorpayOrderId String        @unique @map("razorpay_order_id") @db.VarChar(100)
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("INR") @db.VarChar(3)
  status         String         @db.VarChar(50)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([organizationId])
  @@map("orders")
}

model Payment {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  customerId        String         @map("customer_id") @db.Uuid
  orderId           String?        @map("order_id") @db.Uuid
  razorpayPaymentId String         @unique @map("razorpay_payment_id") @db.VarChar(100)
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("INR") @db.VarChar(3)
  status            PaymentStatus  @default(CREATED)
  method            String?        @db.VarChar(50)
  bank              String?        @db.VarChar(100)
  wallet            String?        @db.VarChar(100)
  vpa               String?        @db.VarChar(100)
  errorCode         String?        @map("error_code") @db.VarChar(100)
  errorDescription  String?        @map("error_description") @db.Text
  errorSource       String?        @map("error_source") @db.VarChar(100)
  errorStep         String?        @map("error_step") @db.VarChar(100)
  errorReason       String?        @map("error_reason") @db.VarChar(100)
  rawEventPayload   Json?          @map("raw_event_payload")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order             Order?         @relation(fields: [orderId], references: [id])
  recoveryCases     RecoveryCase[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("payments")
}

// -------------------------------------------------------------
// Webhook Ingestion & Event Ledger (Idempotency)
// -------------------------------------------------------------

model WebhookEvent {
  id                 String                  @id @default(uuid()) @db.Uuid
  provider           String                  @default("razorpay") @db.VarChar(50)
  providerEventId    String                  @map("provider_event_id") @db.VarChar(100)
  eventType          String                  @map("event_type") @db.VarChar(100)
  signatureValid     Boolean                 @map("signature_valid")
  payloadHash        String                  @map("payload_hash") @db.VarChar(64)
  rawPayload         Json                    @map("raw_payload")
  processingStatus   WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processingAttempts Int                     @default(0) @map("processing_attempts")
  lastError          String?                 @map("last_error") @db.Text
  traceId            String?                 @map("trace_id") @db.VarChar(100)
  receivedAt         DateTime                @default(now()) @map("received_at")
  firstProcessedAt   DateTime?               @map("first_processed_at")
  lastProcessedAt    DateTime?               @map("last_processed_at")

  @@unique([provider, providerEventId])
  @@index([processingStatus, receivedAt])
  @@map("webhook_events")
}

// -------------------------------------------------------------
// Recovery Engine & Governance
// -------------------------------------------------------------

model RecoveryCase {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  customerId         String             @map("customer_id") @db.Uuid
  paymentId          String             @map("payment_id") @db.Uuid
  amountAtRisk       Decimal            @map("amount_at_risk") @db.Decimal(12, 2)
  currency           String             @default("INR") @db.VarChar(3)
  reasonCode         String             @map("reason_code") @db.VarChar(100)
  priorityScore      Int                @default(50) @map("priority_score")
  status             RecoveryStatus     @default(PENDING)
  currentStrategy    RecoveryActionType? @map("current_strategy")
  attemptCount       Int                @default(0) @map("attempt_count")
  maxAllowedAttempts Int                @default(3) @map("max_allowed_attempts")
  nextActionAt       DateTime?          @map("next_action_at")
  expiresAt          DateTime           @map("expires_at")
  resolvedAt         DateTime?          @map("resolved_at")
  recoveredPaymentId String?            @map("recovered_payment_id") @db.VarChar(100)
  traceId            String?            @map("trace_id") @db.VarChar(100)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment            Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actions            RecoveryAction[]
  approvals          Approval[]
  recoveryTokens     CustomerRecoveryToken[]

  @@index([organizationId, status])
  @@index([organizationId, nextActionAt])
  @@map("recovery_cases")
}

model RecoveryAction {
  id                 String                @id @default(uuid()) @db.Uuid
  recoveryCaseId     String                @map("recovery_case_id") @db.Uuid
  actionType         RecoveryActionType    @map("action_type")
  requestedBy        ActorType             @map("requested_by")
  policyDecision     String                @map("policy_decision") @db.VarChar(50)
  executionStatus    ActionExecutionStatus @default(SCHEDULED) @map("execution_status")
  idempotencyKey     String                @unique @map("idempotency_key") @db.VarChar(255)
  actionPayload      Json                  @map("action_payload")
  executionResult    Json?                 @map("execution_result")
  providerReference  String?               @map("provider_reference") @db.VarChar(150)
  errorCode          String?               @map("error_code") @db.VarChar(100)
  errorMessage       String?               @map("error_message") @db.Text
  scheduledFor       DateTime              @default(now()) @map("scheduled_for")
  executedAt         DateTime?             @map("executed_at")
  completedAt        DateTime?             @map("completed_at")
  createdAt          DateTime              @default(now()) @map("created_at")

  recoveryCase       RecoveryCase          @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([recoveryCaseId])
  @@index([executionStatus, scheduledFor])
  @@map("recovery_actions")
}

model CustomerRecoveryToken {
  id             String       @id @default(uuid()) @db.Uuid
  recoveryCaseId String       @map("recovery_case_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime     @map("expires_at")
  isUsed         Boolean      @default(false) @map("is_used")
  isRevoked      Boolean      @default(false) @map("is_revoked")
  accessedCount  Int          @default(0) @map("accessed_count")
  lastAccessedAt DateTime?    @map("last_accessed_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  recoveryCase   RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("customer_recovery_tokens")
}

// -------------------------------------------------------------
// Policy Engine & Governance
// -------------------------------------------------------------

model Policy {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  code                String       @db.VarChar(50)
  name                String       @db.VarChar(150)
  version             Int          @default(1)
  description         String?      @db.Text
  rulesDSL            Json         @map("rules_dsl")
  maxDiscountInr      Decimal      @default(100.00) @map("max_discount_inr") @db.Decimal(10, 2)
  maxRetryAttempts    Int          @default(3) @map("max_retry_attempts")
  minIntervalHours    Int          @default(6) @map("min_interval_hours")
  highValueThreshold  Decimal      @default(10000.00) @map("high_value_threshold") @db.Decimal(12, 2)
  requiresHumanReview Boolean      @default(false) @map("requires_human_review")
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code, version])
  @@index([organizationId, isActive])
  @@map("policies")
}

model Approval {
  id             String         @id @default(uuid()) @db.Uuid
  recoveryCaseId String         @map("recovery_case_id") @db.Uuid
  requestedBy    ActorType      @default(AI_AGENT) @map("requested_by")
  requestedAction RecoveryActionType @map("requested_action")
  actionPayload  Json           @map("action_payload")
  reasonCode     String         @map("reason_code") @db.VarChar(100)
  status         ApprovalStatus @default(PENDING_REVIEW)
  reviewedById   String?        @map("reviewed_by_id") @db.Uuid
  reviewNotes    String?        @map("review_notes") @db.Text
  expiresAt      DateTime       @map("expires_at")
  reviewedAt     DateTime?      @map("reviewed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  recoveryCase   RecoveryCase   @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  reviewedBy     User?          @relation("ApproverUser", fields: [reviewedById], references: [id])

  @@index([recoveryCaseId])
  @@index([status])
  @@map("approvals")
}

// -------------------------------------------------------------
// AI Telemetry & Prompt Governance
// -------------------------------------------------------------

model PromptRegistry {
  id             String    @id @default(uuid()) @db.Uuid
  promptKey      String    @map("prompt_key") @db.VarChar(100)
  version        String    @db.VarChar(50)
  systemPrompt   String    @map("system_prompt") @db.Text
  templateSchema Json      @map("template_schema")
  modelTarget    String    @map("model_target") @db.VarChar(100)
  checksum       String    @db.VarChar(64)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([promptKey, version])
  @@map("prompt_registry")
}

model AiDecisionLog {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  recoveryCaseId   String    @map("recovery_case_id") @db.Uuid
  promptKey        String    @map("prompt_key") @db.VarChar(100)
  promptVersion    String    @map("prompt_version") @db.VarChar(50)
  modelProvider    String    @map("model_provider") @db.VarChar(50)
  modelName        String    @map("model_name") @db.VarChar(100)
  inputTokens      Int       @map("input_tokens")
  outputTokens     Int       @map("output_tokens")
  latencyMs        Int       @map("latency_ms")
  estimatedCostUsd Decimal   @map("estimated_cost_usd") @db.Decimal(8, 6)
  boundedContext   Json      @map("bounded_context")
  rawModelOutput   Json      @map("raw_model_output")
  parsedDecision   Json      @map("parsed_decision")
  isFallbackUsed   Boolean   @default(false) @map("is_fallback_used")
  fallbackReason   String?   @map("fallback_reason") @db.VarChar(100)
  traceId          String?   @map("trace_id") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([organizationId, recoveryCaseId])
  @@map("ai_decision_logs")
}

// -------------------------------------------------------------
// Transactional Outbox & Notifications
// -------------------------------------------------------------

model NotificationOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  channel        String    @db.VarChar(50)
  recipient      String    @db.VarChar(255)
  templateKey    String    @map("template_key") @db.VarChar(100)
  payload        Json
  isSent         Boolean   @default(false) @map("is_sent")
  retryCount     Int       @default(0) @map("retry_count")
  maxRetries     Int       @default(5) @map("max_retries")
  lastError      String?   @map("last_error") @db.Text
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([isSent, createdAt])
  @@map("notification_outbox")
}

// -------------------------------------------------------------
// Immutable Audit Ledger & Reconciliation
// -------------------------------------------------------------

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorType      ActorType    @map("actor_type")
  actorId        String?      @map("actor_id") @db.Uuid
  action         String       @db.VarChar(100)
  resourceType   String       @map("resource_type") @db.VarChar(100)
  resourceId     String       @map("resource_id") @db.VarChar(100)
  reasonCode     String?      @map("reason_code") @db.VarChar(100)
  policyId       String?      @map("policy_id") @db.VarChar(100)
  requestId      String?      @map("request_id") @db.VarChar(100)
  traceId        String?      @map("trace_id") @db.VarChar(100)
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  previousState  Json?        @map("previous_state")
  newState       Json?        @map("new_state")
  metadata       Json?
  timestamp      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?        @relation("ActorUser", fields: [actorId], references: [id])

  @@index([organizationId, timestamp])
  @@index([resourceType, resourceId])
  @@index([traceId])
  @@map("audit_events")
}

model ReconciliationLog {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  paymentId      String               @map("payment_id") @db.VarChar(100)
  dbStatus       PaymentStatus        @map("db_status")
  gatewayStatus  PaymentStatus        @map("gateway_status")
  status         ReconciliationStatus @default(MATCHED)
  actionTaken    String?              @map("action_taken") @db.Text
  discrepancyDetails Json?           @map("discrepancy_details")
  reconciledAt   DateTime             @default(now()) @map("reconciled_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("reconciliation_logs")
}

// -------------------------------------------------------------
// Admin Controls & Feature Flags
// -------------------------------------------------------------

model TenantFeatureFlag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String       @db.VarChar(100)
  isEnabled      Boolean      @default(false) @map("is_enabled")
  configValue    Json?        @map("config_value")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("tenant_feature_flags")
}
