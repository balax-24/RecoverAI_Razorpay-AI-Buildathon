# ==============================================================================
# RecoverAI - Environment Configuration Matrix
# ==============================================================================

# Node Runtime
NODE_ENV=development
PORT=4000
WEB_PORT=3000
OPS_PORT=3001

# Databases
# PostgreSQL connection pool URI (Prisma format)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverai?schema=public
# Direct URL for Prisma migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/recoverai?schema=public

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# Security & Secrets
# 32-byte hex key for session signing
SESSION_SECRET=c874b3e05a8427f309a63ef026046e7f830a84e27f495034175efac871234567
# 32-byte hex key for AES-256-GCM field encryption
APP_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f901a2b3c4d5e6f708192a3b4c5d6e7f890

# Razorpay Test Mode Credentials
# Must start with rzp_test_ for public competition/demonstrations
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# AI Decision Engine
AI_PROVIDER=gemini
# Google Gemini API Key
GEMINI_API_KEY=AIzaSy_YourGeminiApiKeyHere
# Optional OpenAI fallback
OPENAI_API_KEY=

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# OpenTelemetry & Observability
OTEL_SERVICE_NAME=recoverai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sentry Error Tracking (Optional for dev)
SENTRY_DSN=

# Platform Controls & Safety
SAFE_MODE_ENABLED=false
GLOBAL_RECOVERY_AUTOMATION=true
